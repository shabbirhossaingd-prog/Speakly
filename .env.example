NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Free (production auth, durable database and private PDF storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BOOKS_BUCKET=speakly-books

# Gemini API free-tier key from Google AI Studio.
# Keep this server-side. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Speaking transcription uses the browser Web Speech API first, so no STT key is required.
# Pronunciation scoring remains an optional future provider feature.

# Payment is optional/future. Free MVP does not require a payment provider.
PAYMENT_API_URL=
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

# Comma-separated emails allowed to use /admin
ADMIN_EMAILS=
